# Copy to .env and adjust
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
# Comma separated hostnames the app is reached by
ALLOWED_HOSTS=calibrator.example.com,192.168.205.174,localhost
# Full origins (scheme+host) used through the reverse proxy
CSRF_TRUSTED_ORIGINS=https://calibrator.example.com
# Set to 1 when the reverse proxy terminates HTTPS (sends X-Forwarded-Proto)
BEHIND_HTTPS_PROXY=1
TIME_ZONE=UTC
